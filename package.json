{
  "name": "anonshare",
  "version": "5.1.0",
  "private": true,
  "description": "Live, end-to-end encrypted text and code sharing in the browser.",
  "license": "MIT",
  "homepage": "https://code.avishkark.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvishkarKedar/textshare.git"
